[submodule "Hurrican/3rdparty/SDL_image"]
	path = Hurrican/3rdparty/SDL_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "Hurrican/3rdparty/SDL_mixer"]
	path = Hurrican/3rdparty/SDL_mixer
	url = https://github.com/libsdl-org/SDL_mixer.git
